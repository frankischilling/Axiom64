+/* Expand question labels without losing their boundaries.  Compression
+ * consumes only the original pointer bytes; traversal and output are bounded. */
+static int question_name(const unsigned char *msg, int len, int *pos,
+	unsigned char *name)
+{
+	int cursor = *pos, end = -1, used = 0;
+	for (int hops=0; cursor<len && hops<len; hops++) {
+		int label = msg[cursor++];
+		if ((label & 0xc0) == 0xc0) {
+			if (cursor == len) return -1;
+			if (end < 0) end = cursor+1;
+			cursor = (label & 63)*256 + msg[cursor];
+			continue;
+		}
+		if (label & 0xc0 || cursor+label>len || used+label+1>255 ||
+			(label && used+label+1==255))
+			return -1;
+		name[used++] = label;
+		if (!label) {
+			*pos = end < 0 ? cursor : end;
+			return used;
+		}
+		for (int k=0; k<label; k++) {
+			int ch = msg[cursor++];
+			name[used++] = ch>='A' && ch<='Z' ? ch+('a'-'A') : ch;
+		}
+	}
+	return -1;
+}
+
+static int matching_response(const unsigned char *a, int alen,
+	const unsigned char *q, int qlen)
+{
+	if (alen<12 || qlen<12 || a[0]!=q[0] || a[1]!=q[1] ||
+		(a[2] & 0xf8) != ((q[2] & 0x78) | 0x80)) return 0;
+	/* Some servers omit the question.  If present, match every question. */
+	if (!a[4] && !a[5]) return 1;
+	if (a[4]!=q[4] || a[5]!=q[5]) return 0;
+	int ap=12, qp=12, count=q[4]*256+q[5];
+	for (int k=0; k<count; k++) {
+		unsigned char aname[255], qname[255];
+		int as = question_name(a, alen, &ap, aname);
+		int qs = question_name(q, qlen, &qp, qname);
+		if (as<0 || as!=qs || memcmp(aname, qname, as) ||
+			ap+4>alen || qp+4>qlen || memcmp(a+ap, q+qp, 4)) return 0;
+		ap += 4;
+		qp += 4;
+	}
+	return 1;
 }
 
