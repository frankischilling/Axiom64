RandomPlacement
NoGrabServer
NoTitle { "xeyes" }
Color {
    BorderColor "#4f80a8"
    BorderTileBackground "#23374d"
    BorderTileForeground "#23374d"
    TitleBackground "#23374d"
    TitleForeground "white"
    MenuBackground "#23374d"
    MenuForeground "white"
}
TitleFont "fixed"
MenuFont "fixed"
IconFont "fixed"
IconManagerFont "fixed"
ResizeFont "fixed"
BorderWidth 2
Button1 = : title : f.move
Button2 = : title : f.raise
Button3 = : title : f.resize
Button1 = : root : f.menu "main"
Menu "main" {
    "Axiom64" f.title
    "Terminal" f.exec "xterm -e /bin/bash -i &"
    "Games" f.menu "games"
    "Raise" f.raise
    "Move" f.move
    "Resize" f.resize
    "Close" f.delete
}
Menu "games" {
    "Games" f.title
    "Freedoom Phase 1" f.exec "/usr/bin/freedoom 1 &"
    "Freedoom Phase 2" f.exec "/usr/bin/freedoom 2 &"
}
